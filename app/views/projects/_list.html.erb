<%# Shared by an owner's project list and a repository's linked projects. %>
<% if projects.any? %>
  <ul class="divide-y divide-gray-200 overflow-hidden rounded-lg border border-gray-200 bg-white dark:divide-gray-700 dark:border-gray-700 dark:bg-[#0E1116]">
    <% projects.each do |project| %>
      <%= render ProjectListItemComponent.new(project: project) %>
    <% end %>
  </ul>
<% else %>
  <p class="rounded-lg border border-gray-200 px-4 py-6 text-center text-sm italic text-gray-500 dark:border-gray-700 dark:text-gray-400">
    <%= empty %>
  </p>
<% end %>
