<%# Repository-level tabs. `current` is :code, :issues, :pulls, :branches or :commits. %>
<nav class="mt-4 flex gap-6 overflow-x-auto border-b border-gray-200 dark:border-gray-700" aria-label="<%= t('navigation.repository_tabs') %>">
  <% [[:code, repo_tree_path(repository), t('trees.show.code')],
      [:issues, repo_issues_path(repository), t('issues.index.title')],
      [:pulls, repo_pulls_path(repository), t('pulls.index.title')],
      [:branches, repo_branches_path(repository), t('branches.index.title')],
      [:commits, repo_commits_path(repository), t('commits.index.title')]].each do |tab, path, label| %>
    <% active = current == tab %>
    <%= link_to label, path,
        class: "-mb-px whitespace-nowrap border-b-2 px-1 pb-2 text-sm font-medium #{active ? 'border-emerald-500 text-gray-900 dark:text-white' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:text-white'}",
        "aria-current": (active ? "page" : nil) %>
  <% end %>
</nav>
