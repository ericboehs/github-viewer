<%# Shared header for the pull request tabs and the issue show page. %>
<%# `current_tab` selects which sub-tab is highlighted; it is ignored for issues, %>
<%# which have no sub-navigation. %>
<header class="mb-6 sm:mb-8">
  <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8 mb-4">
    <%= render 'shared/flash_messages' %>
  </div>
  <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
    <div class="mb-3">
      <h1 class="text-2xl sm:text-3xl font-bold leading-tight tracking-tight text-gray-900 dark:text-white break-words">
        <%= @issue.title %>
        <%= link_to "##{@issue.number}",
            github_item_url,
            target: "_blank",
            rel: "noopener noreferrer",
            class: "text-gray-500 dark:text-gray-400 font-normal hover:text-gray-700 dark:hover:text-gray-300 hover:underline" %>
      </h1>
    </div>

    <!-- State badge (always visible) -->
    <div class="hidden lg:flex items-center">
      <%= render IssueStateComponent.new(state: @issue.display_state, show_text: true) %>
    </div>

    <!-- Mobile: State, Assignee, and Labels on one line (hidden on lg and up) -->
    <div class="lg:hidden mt-4">
      <div class="flex flex-wrap items-center gap-1.5">
        <%= render IssueStateComponent.new(state: @issue.display_state, show_text: true) %>
        <% if @issue.assignees.present? %>
          <% @issue.assignees.each do |assignee| %>
            <% assignee_login = assignee["login"] || assignee[:login] %>
            <%= link_to list_index_path(@repository, q: "#{default_list_query} assignee:#{assignee_login}"), class: "inline-flex items-center gap-1 hover:opacity-70 transition-opacity ml-2" do %>
              <%= render AvatarComponent.new(
                src: assignee["avatar_url"] || assignee[:avatar_url],
                alt: assignee_login,
                size: :small
              ) %>
              <span class="text-sm text-gray-900 dark:text-gray-200 font-medium"><%= assignee_login %></span>
            <% end %>
          <% end %>
        <% end %>
        <% if @issue.labels.present? %>
          <% @issue.labels.each_with_index do |label, index| %>
            <span class="<%= index == 0 ? 'ml-2' : '' %>">
              <%= render IssueLabelComponent.new(label: label, repository: @repository) %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if pull_request_scope? %>
      <%= render PullRequestTabsComponent.new(issue: @issue, repository: @repository, current_tab: current_tab) %>
    <% end %>
  </div>
</header>
