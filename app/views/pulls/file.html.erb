<% content_for :title, "#{@path} · #{@issue.title} ##{@issue.number} - #{@repository.full_name}" %>

<div class="min-h-full bg-gray-50 dark:bg-[#0E1116]">
  <%= render 'shared/navbar' %>

  <div class="py-5">
    <%= render 'issues/item_header', current_tab: :files %>

    <main>
      <div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-8">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
          <%= link_to files_repository_pull_path(@repository, @issue.number),
              class: "inline-flex items-center gap-1 text-sm text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200" do %>
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M7.78 12.53a.75.75 0 0 1-1.06 0L2.47 8.28a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 1.06L4.81 7h7.44a.75.75 0 0 1 0 1.5H4.81l2.97 2.97a.75.75 0 0 1 0 1.06Z" />
            </svg>
            <%= t('pulls.file.back_to_files') %>
          <% end %>

          <%# Markdown is the only thing with two useful presentations, so the %>
          <%# toggle only appears for it. %>
          <% if @file && @file[:binary].blank? && FileContentComponent.markdown?(@path) %>
            <div class="inline-flex overflow-hidden rounded-md border border-gray-300 text-sm dark:border-gray-600">
              <% [[t('pulls.file.rendered'), nil], [t('pulls.file.source'), 'source']].each do |label, display| %>
                <% active = params[:display].presence == display %>
                <%= link_to label,
                    file_repository_pull_path(@repository, @issue.number, path: @path, display: display),
                    class: "px-3 py-1 #{active ? 'bg-gray-200 font-medium text-gray-900 dark:bg-gray-700 dark:text-white' : 'text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800'}",
                    "aria-current": (active ? "page" : nil) %>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @file %>
          <%= render FileContentComponent.new(file: @file, path: @path, raw: params[:display] == 'source') %>
        <% end %>
      </div>
    </main>
  </div>
</div>
