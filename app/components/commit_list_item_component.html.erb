<div class="flex items-start justify-between gap-4 px-4 py-3">
  <div class="min-w-0 flex-1">
    <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 break-words"><%= subject %></p>

    <% if body %>
      <pre class="mt-1 whitespace-pre-wrap break-words font-mono text-xs text-gray-600 dark:text-gray-400"><%= body %></pre>
    <% end %>

    <div class="mt-1 flex flex-wrap items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
      <% if avatar_url %>
        <%= render AvatarComponent.new(src: avatar_url, alt: author_label.to_s, size: :small) %>
      <% end %>
      <% if author_label %>
        <span class="font-medium text-gray-700 dark:text-gray-300"><%= author_label %></span>
      <% end %>
      <% if authored_at %>
        <span><%= t('pulls.commits.committed') %> <%= helpers.time_ago_tag(authored_at) %></span>
      <% end %>
    </div>
  </div>

  <%= link_to short_sha, commit_url,
      target: "_blank",
      rel: "noopener noreferrer",
      class: "flex-shrink-0 rounded border border-gray-300 px-2 py-1 font-mono text-xs text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200" %>
</div>
