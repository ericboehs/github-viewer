<%# Each column scrolls on its own so that one enormous Done does not set the
    height of the page. %>
<div class="flex gap-4 overflow-x-auto pb-4" data-project-board-target="board">
  <% groups.each do |column, column_items| %>
    <%# How many cards the column is sitting on, which is what the button at
        its foot offers - until a later page lands and the browser recounts. %>
    <% over = [ column_items.size - ProjectBoardComponent::VISIBLE_LIMIT, 0 ].max %>
    <section class="flex max-h-[70vh] w-72 flex-shrink-0 flex-col rounded-lg bg-gray-100 p-3 dark:bg-gray-800/50"
            data-column-for="<%= column.key %>">
      <header class="mb-3 flex items-center justify-between gap-2">
        <span class="<%= ProjectBoardComponent::COLUMN_CLASSES %> <%= column.css_class %>"><%= column.name %></span>
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400" data-board-count><%= column_items.size %></span>
      </header>

      <div class="flex min-h-0 flex-col gap-2 overflow-y-auto"
          data-cards-for="<%= column.key %>" data-limit="<%= ProjectBoardComponent::VISIBLE_LIMIT %>">
        <% column_items.each_with_index do |item, index| %>
          <%= render ProjectCardComponent.new(item: item, layout: layout,
                hidden: index >= ProjectBoardComponent::VISIBLE_LIMIT) %>
        <% end %>
      </div>

      <%# Outside the scrolling part, so it stays at the foot of the column.
          The counts it carries are the templates the Stimulus controller
          rewrites as later pages arrive. %>
      <button type="button" class="mt-2 rounded-md px-2 py-1 text-left text-xs font-medium text-blue-600 hover:bg-gray-200 hover:underline dark:text-blue-400 dark:hover:bg-gray-700"
          data-column-expand
          data-one="<%= t("projects.board.show_more", count: 1) %>"
          data-other="<%= t("projects.board.show_more", count: 0) %>"
          data-action="project-board#expand"
          <%= "hidden" if over.zero? %>><%= t("projects.board.show_more", count: over) %></button>

      <%# Outside the cards container on purpose: what is in there is counted.
          Every column carries one, because which of them the next page fills
          is not known until it arrives. %>
      <div class="mt-2 animate-pulse rounded-md border border-dashed border-gray-300 p-3 dark:border-gray-600"
          data-column-loading <%= "hidden" unless loading %>>
        <span class="sr-only"><%= t("projects.board.loading_column") %></span>
        <div class="h-3 w-3/4 rounded bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>
        <div class="mt-2 h-3 w-1/2 rounded bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>
      </div>
    </section>
  <% end %>
</div>

<%# Grouping by a field that does not enumerate its values - a repository, an
    assignee - means a column can turn up in a later page of items, so the
    browser needs a shape to build one from. %>
<template data-project-board-target="columnTemplate">
  <section class="flex max-h-[70vh] w-72 flex-shrink-0 flex-col rounded-lg bg-gray-100 p-3 dark:bg-gray-800/50" data-column-for>
    <header class="mb-3 flex items-center justify-between gap-2">
      <span class="<%= ProjectBoardComponent::COLUMN_CLASSES %> <%= Projects::Option::DEFAULT_CLASS %>" data-board-name></span>
      <span class="text-xs font-medium text-gray-500 dark:text-gray-400" data-board-count>0</span>
    </header>
    <div class="flex min-h-0 flex-col gap-2 overflow-y-auto" data-cards-for data-limit="<%= ProjectBoardComponent::VISIBLE_LIMIT %>"></div>
    <button type="button" class="mt-2 rounded-md px-2 py-1 text-left text-xs font-medium text-blue-600 hover:bg-gray-200 hover:underline dark:text-blue-400 dark:hover:bg-gray-700"
        data-column-expand
        data-one="<%= t("projects.board.show_more", count: 1) %>"
        data-other="<%= t("projects.board.show_more", count: 0) %>"
        data-action="project-board#expand" hidden></button>
    <div class="mt-2 animate-pulse rounded-md border border-dashed border-gray-300 p-3 dark:border-gray-600" data-column-loading>
      <span class="sr-only"><%= t("projects.board.loading_column") %></span>
      <div class="h-3 w-3/4 rounded bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>
      <div class="mt-2 h-3 w-1/2 rounded bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>
    </div>
  </section>
</template>
