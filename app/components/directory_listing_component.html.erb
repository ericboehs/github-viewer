<div class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
  <% if entries.empty? %>
    <p class="px-4 py-6 text-center text-sm text-gray-500 dark:text-gray-400"><%= t("trees.listing.empty") %></p>
  <% else %>
    <table class="w-full border-collapse text-sm">
      <caption class="sr-only"><%= t("trees.listing.caption") %></caption>
      <tbody>
        <% if parent_path %>
          <tr class="border-b border-gray-200 dark:border-gray-700">
            <td class="px-4 py-2" colspan="2">
              <%= link_to "..",
                          helpers.repository_tree_path(repository, path: parent_path, ref: ref),
                          class: "font-mono text-blue-600 hover:underline dark:text-blue-400",
                          "aria-label": t("trees.listing.parent") %>
            </td>
          </tr>
        <% end %>

        <% entries.each do |entry| %>
          <tr class="border-b border-gray-200 last:border-0 hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800">
            <td class="px-4 py-2">
              <span class="flex items-center gap-2">
                <% if directory?(entry) %>
                  <svg class="h-4 w-4 flex-shrink-0 text-blue-500 dark:text-blue-400" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5L6.2 1.7A1.75 1.75 0 0 0 4.96 1H1.75Z"></path>
                  </svg>
                <% else %>
                  <svg class="h-4 w-4 flex-shrink-0 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M2 1.75C2 .784 2.784 0 3.75 0h5.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 12.25 16h-8.5A1.75 1.75 0 0 1 2 14.25Zm7 .5V5h2.75Z"></path>
                  </svg>
                <% end %>

                <% if navigable?(entry) %>
                  <%= link_to entry[:name],
                              helpers.repository_tree_path(repository, path: entry[:path], ref: ref),
                              class: "truncate text-blue-600 hover:underline dark:text-blue-400" %>
                <% else %>
                  <span class="truncate text-gray-500 dark:text-gray-400"><%= entry[:name] %></span>
                <% end %>
              </span>
            </td>
            <td class="w-24 px-4 py-2 text-right text-xs text-gray-500 dark:text-gray-400">
              <% if size_for(entry) %>
                <%= number_to_human_size(size_for(entry)) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
