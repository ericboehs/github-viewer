<article class="rounded-md border border-gray-200 bg-white p-3 shadow-xs dark:border-gray-700 dark:bg-[#151B23]"
        data-sort-key="<%= sort_key %>" <%= "hidden" if hidden %>>
  <div class="flex items-start gap-2">
    <span class="mt-0.5 flex-shrink-0 scale-75 origin-top-left">
      <%= render IssueStateComponent.new(state: item.state) %>
    </span>

    <div class="min-w-0 flex-1">
      <% if path %>
        <%= link_to item.title, path,
            class: "block text-sm font-medium text-gray-900 hover:text-blue-600 hover:underline dark:text-white dark:hover:text-blue-400" %>
      <% else %>
        <span class="block text-sm font-medium text-gray-900 dark:text-white"><%= item.title %></span>
      <% end %>

      <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
        <%= subtitle || t("projects.card.draft") %>
      </p>

      <% if item.labels.any? %>
        <div class="mt-2 flex flex-wrap gap-1">
          <% item.labels.each do |label| %>
            <%= render IssueLabelComponent.new(label: label) %>
          <% end %>
        </div>
      <% end %>

      <% if chips.any? %>
        <dl class="mt-2 flex flex-wrap gap-1">
          <% chips.each do |name, text, field| %>
            <div class="inline-flex items-center gap-1">
              <dt class="sr-only"><%= name %></dt>
              <dd class="<%= field_chip_classes(field, text) %>" title="<%= name %>"><%= text %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>

    <% if assignees.any? %>
      <div class="flex flex-shrink-0 -space-x-1">
        <% assignees.each do |assignee| %>
          <%= render AvatarComponent.new(src: assignee[:avatar_url], alt: assignee[:login], size: 5, loading: "lazy") %>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
