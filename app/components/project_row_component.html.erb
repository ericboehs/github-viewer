<%# The card template reads `columns` through the layout. %>
<tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50" data-sort-key="<%= sort_key %>">
  <% columns.each do |name| %>
    <td class="px-4 py-2 align-top text-sm text-gray-700 dark:text-gray-300">
      <% if title_column?(name) %>
        <div class="flex items-start gap-2">
          <span class="flex-shrink-0 scale-75 origin-top-left">
            <%= render IssueStateComponent.new(state: item.state) %>
          </span>
          <div class="min-w-0">
            <% if path %>
              <%= link_to item.title, path, class: "font-medium text-gray-900 hover:text-blue-600 hover:underline dark:text-white dark:hover:text-blue-400" %>
            <% else %>
              <span class="font-medium text-gray-900 dark:text-white"><%= item.title %></span>
            <% end %>
            <% if item.number %>
              <span class="ml-1 text-xs text-gray-500 dark:text-gray-400">#<%= item.number %></span>
            <% end %>
          </div>
        </div>
      <% elsif built_in?(name) %>
        <%= built_in_text(name) %>
      <% elsif (text = value_for(name)) %>
        <% if (field = field_for(name))&.single_select? %>
          <span class="<%= field_chip_classes(field, text) %>"><%= text %></span>
        <% else %>
          <%= text %>
        <% end %>
      <% end %>
    </td>
  <% end %>
</tr>
